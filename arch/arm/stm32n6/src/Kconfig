#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_CHIP_STM32N6

menu "STM32N6 Chip Selection"

choice
	prompt "STM32N6 Chip Configuration"
	default ARCH_CHIP_STM32N647X0

config ARCH_CHIP_STM32N647X0
	bool "STM32N647X0"
	select ARCH_CORTEXM55
	select ARCH_HAVE_MPU
	select ARCH_HAVE_FPU
	select ARM_HAVE_MVE
	select ARMV8M_HAVE_ICACHE
	select ARMV8M_HAVE_DCACHE

endchoice

endmenu

menu "STM32N6 Clock Configuration"

config STM32N6_USE_HSE
	bool "Use HSE external oscillator"
	default n
	---help---
		Enable HSE (external high-speed oscillator) as clock source.
		If not set, HSI (64MHz internal RC) is used.

config STM32N6_HSE_FREQUENCY
	int "HSE frequency (Hz)"
	default 32000000
	depends on STM32N6_USE_HSE
	---help---
		Frequency of the external HSE oscillator in Hz.

config STM32N6_USE_PLL1
	bool "Enable PLL1 for system clock"
	default n
	depends on STM32N6_USE_HSE
	---help---
		Configure PLL1 to generate 800MHz from HSE, with AHB DIV4
		giving 200MHz conservative system clock. If not set, system
		runs directly from HSI or HSE.

endmenu

menu "STM32N6 Peripheral Selection"

config STM32_USART1
	bool "USART1"
	default n
	select USART1_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config STM32_USART2
	bool "USART2"
	default n
	select USART2_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config STM32_USART3
	bool "USART3"
	default n
	select USART3_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

endmenu

endif
