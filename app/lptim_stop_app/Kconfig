#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_137_LPTIM_STOP_APP
	bool "Contest 2026 team 137 LPTIM Stop-mode wakeup demo"
	default n
	depends on STM32_LPTIM_STOPWAKE
	---help---
		Enable the contest 2026 team 137 LPTIM Stop-mode wakeup demo
		(lptim_stop).  Arms LPTIM3 as a one-shot on the LSI, enters
		CPU Stop mode, and reports whether the LPTIM interrupt woke
		the core.  Requires STM32_LPTIM_STOPWAKE in the arch layer.
