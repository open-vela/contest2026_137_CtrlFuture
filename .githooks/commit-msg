#!/bin/bash
# .githooks/commit-msg — validate commit message format
#
# Rules enforced (CLAUDE.md + openvela checkpatch):
#   1. <scope>: <summary> format with allowed scopes
#   2. Subject line <= 72 chars
#   3. Signed-off-by trailer required
#   4. No Gerrit Change-Id
#   5. No AI Co-Authored-By markers
#   6. No Chinese characters
#
# Install:
#   git config core.hooksPath .githooks

MSG_FILE="$1"

CLEAN_MSG=$(grep -v '^#' "$MSG_FILE")
FIRST_LINE=$(echo "$CLEAN_MSG" | head -n1)

FAIL=0

# --- Scope format ---
SCOPE_RE="^(board/contest_board/src|board/contest_board|app|docs|scripts|ci|arch): .+"
if ! echo "$FIRST_LINE" | grep -qE "$SCOPE_RE"; then
    echo "commit-msg: subject must match '<scope>: <summary>'"
    echo "  Allowed scopes: board/contest_board: board/contest_board/src: app: docs: scripts: ci: arch:"
    echo "  Got: $FIRST_LINE"
    FAIL=1
fi

# --- Subject length ---
LEN=${#FIRST_LINE}
if [ "$LEN" -gt 72 ]; then
    echo "commit-msg: subject is $LEN chars (max 72)"
    FAIL=1
fi

# --- Signed-off-by ---
if ! echo "$CLEAN_MSG" | grep -qE '^Signed-off-by: .+ <.+>'; then
    echo "commit-msg: missing Signed-off-by trailer (use git commit -s)"
    FAIL=1
fi

# --- No Gerrit Change-Id ---
if echo "$CLEAN_MSG" | grep -qE '^Change-Id:'; then
    echo "commit-msg: Gerrit Change-Id lines are forbidden"
    FAIL=1
fi

# --- No AI markers ---
if echo "$CLEAN_MSG" | grep -qiE '^Co-Authored-By:'; then
    echo "commit-msg: AI Co-Authored-By markers are forbidden"
    FAIL=1
fi

# --- No Chinese characters ---
if echo "$CLEAN_MSG" | grep -Pq '[\x{4e00}-\x{9fff}]'; then
    echo "commit-msg: Chinese characters are forbidden in commit messages"
    FAIL=1
fi

if [ $FAIL -ne 0 ]; then
    echo ""
    echo "Commit message validation failed."
    echo "Fix and retry, or bypass with: git commit --no-verify"
    exit 1
fi
