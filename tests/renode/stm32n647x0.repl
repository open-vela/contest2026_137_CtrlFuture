// STM32N647X0 Renode Platform Definition
//
// Cortex-M55 @ 64MHz (HSI), 4.2MB SRAM
// Register definitions derived from stm32n647xx.h (CMSIS)
//
// Used for: NuttX NSH boot verification
// ADR-002: Minimum boot (RCC/GPIO/USART1/IRQ/heap/start)

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 64000000
    priorityMask: 0xF0
    IRQ -> cpu@0

// ITCM: 64KB @ 0x00000000 (instruction tightly-coupled memory)
// STM32N647 FLEXRAM: 400KB shared between ITCM (64-256KB) and DTCM
itcm: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x10000

// DTCM: 128KB @ 0x20000000 (data tightly-coupled memory)
dtcm: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

// SRAM1_AXI (secure): 1MB @ 0x34000000
// STM32N647 LRUN mode: code+data in SRAM, DEV boot header at 0x34000000 (1KB)
// NuttX nsh config: code starts at 0x34000400, 4.2MB total
sram: Memory.MappedMemory @ sysbus 0x34000000
    size: 0x420000

// USART1 @ 0x42001000 (APB2 + 0x1000)
// IRQ 159 (USART1_IRQn)
// PE5=TX (AF7), PE6=RX (AF7)
usart1: UART.STM32F7_USART @ sysbus 0x42001000
    frequency: 64000000
    IRQ -> nvic@159

// USART2 @ 0x40004400 (APB1 + 0x4400), IRQ 160
usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 64000000
    IRQ -> nvic@160

// USART3 @ 0x40004800 (APB1 + 0x4800), IRQ 161
usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 64000000
    IRQ -> nvic@161

// UART4 @ 0x40004C00 (APB1 + 0x4C00), IRQ 162
uart4: UART.STM32F7_USART @ sysbus 0x40004C00
    frequency: 64000000
    IRQ -> nvic@162

// UART5 @ 0x40005000 (APB1 + 0x5000), IRQ 163
uart5: UART.STM32F7_USART @ sysbus 0x40005000
    frequency: 64000000
    IRQ -> nvic@163

// USART6 @ 0x42001400 (APB2 + 0x1400), IRQ 164
usart6: UART.STM32F7_USART @ sysbus 0x42001400
    frequency: 64000000
    IRQ -> nvic@164

// UART7 @ 0x40007800 (APB1 + 0x7800), IRQ 165
uart7: UART.STM32F7_USART @ sysbus 0x40007800
    frequency: 64000000
    IRQ -> nvic@165

// UART8 @ 0x40007C00 (APB1 + 0x7C00), IRQ 166
uart8: UART.STM32F7_USART @ sysbus 0x40007C00
    frequency: 64000000
    IRQ -> nvic@166

// UART9 @ 0x42001800 (APB2 + 0x1800), IRQ 167
uart9: UART.STM32F7_USART @ sysbus 0x42001800
    frequency: 64000000
    IRQ -> nvic@167

// USART10 @ 0x42001C00 (APB2 + 0x1C00), IRQ 168
usart10: UART.STM32F7_USART @ sysbus 0x42001C00
    frequency: 64000000
    IRQ -> nvic@168

// IWDG @ 0x46004800 (APB4 + 0x4800)
iwdg: Miscellaneous.STM32N6_IWDG @ sysbus 0x46004800

// RTC @ 0x46004000 (APB4 + 0x4000)
rtc: Miscellaneous.STM32N6_RTC @ sysbus 0x46004000

// EXTI @ 0x46025000 (AHB4 + 0x5000)
exti: Miscellaneous.STM32N6_EXTI @ sysbus 0x46025000

// GPDMA1 @ 0x40021000 (AHB1 + 0x1000)
gpdma1: Miscellaneous.STM32N6_GPDMA @ sysbus 0x40021000

// I2C1 @ 0x40005400 (APB1 + 0x5400)
i2c1: Miscellaneous.STM32N6_I2C @ sysbus 0x40005400

// XSPI1 @ 0x48025000 (AHB5 + 0x5000)
xspi1: Miscellaneous.STM32N6_XSPI @ sysbus 0x48025000

// XSPI2 memory-mapped flash @ 0x70000000 (32MB)
xspi2_flash: Memory.MappedMemory @ sysbus 0x70000000
    size: 0x2000000

// SDMMC1 @ 0x48027000 (AHB5 + 0x7000)
sdmmc1: Miscellaneous.STM32N6_SDMMC @ sysbus 0x48027000

// EMAC (Ethernet GMAC) @ 0x48036000 (AHB5 + 0x16000)
emac: Miscellaneous.STM32N6_EMAC @ sysbus 0x48036000

// SAI1 @ 0x42005800 (APB2 + 0x5800)
sai1: Miscellaneous.STM32N6_SAI @ sysbus 0x42005800

// FDCAN1 @ 0x4000A000 (APB1)
fdcan1: Miscellaneous.STM32N6_FDCAN @ sysbus 0x4000A000

// USB OTG HS @ 0x48040000 (AHB5 + 0x20000)
otg: Miscellaneous.STM32N6_OTG @ sysbus 0x48040000

// LTDC (LCD-TFT Display Controller) @ 0x48001000 (APB5 + 0x1000)
ltdc: Miscellaneous.STM32N6_LTDC @ sysbus 0x48001000

// DCMIPP (Camera Pipeline) @ 0x48002000 (APB5 + 0x2000)
dcmipp: Miscellaneous.STM32N6_DCMIPP @ sysbus 0x48002000

// HPDMA1 (High-Performance DMA) @ 0x48020000 (AHB5 + 0x0000)
hpdma1: Miscellaneous.STM32N6_HPDMA @ sysbus 0x48020000

// TIM1 (Advanced Timer) @ 0x42000000 (APB2 + 0x0000)
tim1: Miscellaneous.STM32N6_TIM @ sysbus 0x42000000

// TIM2 (General Purpose Timer) @ 0x40000000 (APB1)
tim2: Miscellaneous.STM32N6_TIM @ sysbus 0x40000000

// LPTIM1 @ 0x40002400 (APB1 + 0x2400)
lptim1: Miscellaneous.STM32N6_LPTIM @ sysbus 0x40002400

// ADC1 @ 0x40022000 (AHB1 + 0x2000)
adc1: Miscellaneous.STM32N6_ADC @ sysbus 0x40022000

// DTS @ 0x4600A000 (APB4 + 0xA000)
dts: Miscellaneous.STM32N6_DTS @ sysbus 0x4600A000

// DMA2D (Chrom-ART) @ 0x48021000 (AHB5 + 0x1000)
dma2d: Miscellaneous.STM32N6_DMA2D @ sysbus 0x48021000

// CSI-2 MIPI @ 0x48006000 (APB5 + 0x6000)
csi: Miscellaneous.STM32N6_CSI @ sysbus 0x48006000

// H.264 Video Encoder @ 0x48005000 (APB5 + 0x5000)
venc: Miscellaneous.STM32N6_VENC @ sysbus 0x48005000

// Neural-ART NPU @ 0x480E0000 (AHB5 + 0xC0000)
npu: Miscellaneous.STM32N6_NPU @ sysbus 0x480E0000

// SAES (Crypto) @ 0x42006000 (APB2 + 0x6000, secure-only, not in CMSIS _BASE_NS)
cryp: Miscellaneous.STM32N6_CRYP @ sysbus 0x42006000

// RNG (Random Number Generator) @ 0x44020000 (AHB3 + 0x0000)
rng: Miscellaneous.STM32N6_RNG @ sysbus 0x44020000

// OTP (via BSEC) @ 0x46009000 (APB4 + 0x9000)
otp: Miscellaneous.STM32N6_OTP @ sysbus 0x46009000

// GPIO Ports A-Q @ AHB4 + offset (each 0x400 bytes)
gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x46020000, +0x400>
    numberOfAFs: 16
gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x46020400, +0x400>
    numberOfAFs: 16
gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x46020800, +0x400>
    numberOfAFs: 16
gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x46020C00, +0x400>
    numberOfAFs: 16
gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x46021000, +0x400>
    numberOfAFs: 16
gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x46021400, +0x400>
    numberOfAFs: 16
gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x46021800, +0x400>
    numberOfAFs: 16
gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x46021C00, +0x400>
    numberOfAFs: 16
gpioPortN: GPIOPort.STM32_GPIOPort @ sysbus <0x46023400, +0x400>
    numberOfAFs: 16
gpioPortO: GPIOPort.STM32_GPIOPort @ sysbus <0x46023800, +0x400>
    numberOfAFs: 16
gpioPortP: GPIOPort.STM32_GPIOPort @ sysbus <0x46023C00, +0x400>
    numberOfAFs: 16
gpioPortQ: GPIOPort.STM32_GPIOPort @ sysbus <0x46024000, +0x400>
    numberOfAFs: 16

// PWR @ 0x46024800 (AHB4 + 0x4800), size 0x80
// C# model: STM32N6_PWR (VOSCR voltage scaling)
pwr: Miscellaneous.STM32N6_PWR @ sysbus 0x46024800

// RCC @ 0x46028000 (AHB4 + 0x8000), size 0x400
// C# model: STM32N6_RCC (CR/SR ON->RDY mirror, peripheral clock enables)
rcc: Miscellaneous.STM32N6_RCC @ sysbus 0x46028000

// SysTick is built into NVIC (systickFrequency above)

// Tag unimplemented peripherals to suppress "unhandled access" warnings
sysbus:
    init:
        // APB1 peripherals (except TIM2-7,12-14, LPTIM1, USART2/3,
        //   UART4/5/7/8, I2C1-3, FDCAN1-3, SPI2/3, WWDG)
        Tag <0x40002500, 0x40002BFF> "APB1_PERIPH_A1"
        Tag <0x40002D00, 0x400037FF> "APB1_PERIPH_A2"
        Tag <0x40004100, 0x400043FF> "APB1_PERIPH_A3"
        Tag <0x40006500, 0x400077FF> "APB1_PERIPH_B"
        Tag <0x40008000, 0x40009FFF> "APB1_PERIPH_C1"
        Tag <0x4000A900, 0x4000BFFF> "APB1_PERIPH_C2"
        Tag <0x4000C100, 0x4000E7FF> "APB1_PERIPH_C3"
        Tag <0x4000E900, 0x4001FFFF> "APB1_PERIPH_D"
        // APB2 peripherals (except TIM1/8/15-18, USART1/6, UART9/10,
        //   SPI1/4/5, SAI1/2)
        Tag <0x42000500, 0x42000FFF> "APB2_PERIPH_A"
        Tag <0x42002000, 0x42002FFF> "APB2_PERIPH_B"
        Tag <0x42003500, 0x42003BFF> "APB2_PERIPH_C"
        Tag <0x42004900, 0x42004FFF> "APB2_PERIPH_D"
        Tag <0x42005100, 0x420057FF> "APB2_PERIPH_E"
        Tag <0x42007000, 0x4201FFFF> "APB2_PERIPH_F"
        // AHB1 peripherals (except GPDMA1, ADC1)
        Tag <0x40022400, 0x4003FFFF> "AHB1_PERIPH"
        // AHB2 peripherals
        Tag <0x42020000, 0x4203FFFF> "AHB2_PERIPH"
        // APB3 peripherals
        Tag <0x44000000, 0x4400FFFF> "APB3_PERIPH"
        // AHB3 peripherals (except RNG @ 0x44020000)
        Tag <0x44020100, 0x4403FFFF> "AHB3_PERIPH"
        // APB4 peripherals (except LPTIM2-5, RTC, IWDG, BSEC/OTP, DTS)
        Tag <0x46000000, 0x460023FF> "APB4_PERIPH_A"
        Tag <0x46003100, 0x46003FFF> "APB4_PERIPH_B"
        Tag <0x46004900, 0x46008FFF> "APB4_PERIPH_C"
        Tag <0x4600A200, 0x4601FFFF> "APB4_PERIPH_D"
        // AHB4 peripherals (except GPIO A-Q, RCC)
        Tag <0x46022000, 0x460233FF> "AHB4_GPIO_GAP1"
        Tag <0x46024400, 0x46024FFF> "AHB4_GPIO_GAP2"
        Tag <0x46025400, 0x46027FFF> "AHB4_GPIO_GAP3"
        Tag <0x46028400, 0x4603FFFF> "AHB4_PERIPH"
        // APB5 peripherals (except LTDC, DCMIPP, VENC, CSI)
        Tag <0x48000000, 0x48000FFF> "APB5_PERIPH"
        Tag <0x48003000, 0x48003FFF> "APB5_PERIPH_B"
        Tag <0x48007000, 0x4801FFFF> "APB5_PERIPH_C"
        // AHB5 peripherals (except HPDMA1, DMA2D, XSPI1, SDMMC1,
        //   XSPI2, NPU, EMAC, OTG)
        Tag <0x48020800, 0x48020FFF> "AHB5_PERIPH_A"
        Tag <0x48022000, 0x48024FFF> "AHB5_PERIPH_B"
        Tag <0x48026000, 0x48026FFF> "AHB5_PERIPH_C"
        Tag <0x48028000, 0x48029FFF> "AHB5_PERIPH_D"
        Tag <0x4802B000, 0x48035FFF> "AHB5_PERIPH_E"
        Tag <0x48037000, 0x4803FBFF> "AHB5_PERIPH_F"
        Tag <0x48081000, 0x480DFFFF> "AHB5_PERIPH_G"
        Tag <0x480E1000, 0x480FFFFF> "AHB5_PERIPH_H"
        // Internal SRAM2
        Tag <0x34420000, 0x34FFFFFF> "SRAM2"
        // FMC/QUADSPI
        Tag <0x90000000, 0x9FFFFFFF> "FMC"
        // ARM FPB (Flash Patch and Breakpoint) debug registers
        Tag <0xE0002000, 0xE0002FFF> "FPB_STUB"
        // ARM ITM/DWT debug registers
        Tag <0xE0001000, 0xE0001FFF> "ITM_STUB"
